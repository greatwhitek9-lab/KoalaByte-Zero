#!/usr/bin/env python3
"""KoalaByte legacy component listing.

This file is retained only as a human-readable reference for older Rev 0.5
production notes. The canonical runtime lives under the koalabyte/ package and
the canonical hardware source is docs/BOM plus docs/bom.yaml.

Rev 0.5 placement notes:
- Legacy LED_L / LED_R WS2812 eye rings have been retired.
- Rev 0.5 production uses EYE1: ESP32-S3 1.28inch Double Eye Round LCD AIoT
  Development Board, Onboard Dual 1.28inch IPS Displays.
- The old nose switch is removed.
- SW_PWR is a back-mounted power on/off switch.
- CAM1 is centered just above the eyes and below the enlarged ears.
"""
from __future__ import annotations

from dataclasses import dataclass
from typing import Dict


@dataclass(frozen=True)
class HardwareComponent:
    ref: str
    name: str
    manufacturer: str
    mpn_or_module: str
    interface: str
    mount: str
    notes: str = ""

    def describe(self) -> str:
        return f"{self.ref}: {self.name} | {self.mpn_or_module} | {self.interface}"


